# MongoDB connection string. Keep this secret and add it in Vercel Project Settings.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Use a long random secret (32+ bytes recommended).
JWT_SECRET=replace-with-a-long-random-secret

# Optional: set to true only while debugging.
APP_DEBUG=false

# Optional for local development; Vercel sets its own port.
PORT=5000
